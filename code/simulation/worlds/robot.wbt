#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  info [
    "The MyBot robot, the robot used in the tutorial of Webots"
  ]
  title "MyBot"
  basicTimeStep 16
  maxStep 1
}
Viewpoint {
  orientation 0.10441349581936693 -0.969606685129755 -0.2212706443305736 5.382793309990334
  position -1.0665288896708753 -0.30238952230022664 1.3427364367002363
}
TexturedBackground {
}
TexturedBackgroundLight {
}
RectangleArena {
	floorSize 20 20
	floorTileSize 20 20
  	wallHeight 0.1
	floorAppearance PBRAppearance {
    baseColor 0.8 0.8 0.8  # <- ТВОЙ ЖЕЛАЕМЫЙ СПЛОШНОЙ ЦВЕТ ПОЛА
    roughness 1            # Чтобы пол не блестел как зеркало
    metalness 0
    baseColorMap ImageTexture {
      url [
        "textures/white.png" # Твоя однотонная картинка (создай 10x10 px в Paint)
      ]
    }
  }
}

Robot {
  translation 0 0 0
  rotation 0 0 1 0
  children [
    
    # --- 1. КОРПУС РОБОТА (Прямоугольный "Box") ---
    Pose {
      translation 0 0 0.035
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.2 0.2 0.2
            roughness 0.8
            metalness 0.2
          }
          geometry DEF BODY Box {
            size 0.12 0.08 0.05
          }
        }
      ]
    }

    # --- 2. КАРАНДАШ ДЛЯ ОТРИСОВКИ ТРАЕКТОРИИ ---
    Pen {
      translation 0 0 0.05
      rotation 1 0 0 0.0
      name "pen"
      inkColor 1 0 0
      inkDensity 1
      leadSize 0.02
      maxDistance 0.5
      write TRUE
    }

    # --- 3. ЛЕВОЕ КОЛЕСО (Ведущее) ---
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0 0.025
		maxVelocity 50
      }
      device [
        RotationalMotor {
          name "left_wheel_motor"
		  maxVelocity 100.0
      	  maxTorque 100.0
        }
        PositionSensor {
          name "left_wheel_encoder"
		  resolution -1
        }
      ]
      endPoint Solid {
        translation 0 0.045 0.025
        rotation 0 0 1 0
        children [
          DEF WHEEL Pose {
            rotation 1 0 0 -1.570796
            children [
              Shape {
                appearance PBRAppearance {
                  baseColor 1 0 0
                  roughness 1
                  metalness 0
                }
                geometry Cylinder {
                  height 0.01
                  radius 0.025
                }
              }
            ]
          }
        ]
        name "left wheel"
        boundingObject USE WHEEL
        physics DEF PHYSICS_WHEEL Physics {
          density -1
          mass 0.05
        }
      }
    }

    # --- 4. ПРАВОЕ КОЛЕСО (Ведущее) ---
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0
        anchor 0 0 0.025
		maxVelocity 50
      }
      device [
        RotationalMotor {
          name "right_wheel_motor"
		  maxVelocity 100.0
      	  maxTorque 100.0
        }
        PositionSensor {
          name "right_wheel_encoder"
		  resolution -1
        }
      ]
      endPoint Solid {
        translation 0 -0.045 0.025
        rotation 0 0 1 0
        children [
          USE WHEEL
        ]
        name "right wheel"
        boundingObject USE WHEEL
        physics USE PHYSICS_WHEEL
      }
    }

    # --- 5. ПЕРЕДНИЙ КАСТЕР (Пассивный) ---
    Solid {
      translation 0.055 0 0.01  # Вынесен на самый нос
      children [
        # Само колесико (шарик)
        Shape {
          appearance PBRAppearance {
            baseColor 0.9 0.9 0.9   # Светло-стальной, хорошо видно
            roughness 0.3
            metalness 0.8
          }
          geometry Sphere {
            radius 0.01
          }
        }
        # Декоративная стойка крепления (идет от шарика вверх к днищу)
        Pose {
          translation 0 0 0.005
          children [
            Shape {
              appearance PBRAppearance { baseColor 0.1 0.1 0.1 roughness 1 }
              geometry Cylinder {
                height 0.01
                radius 0.008
              }
            }
          ]
        }
      ]
      name "front_caster"
      boundingObject Sphere {
        radius 0.01
      }
      physics Physics {
        density -1
        mass 0.02
      }
    }

    # --- 6. ЗАДНИЙ КАСТЕР (Пассивный) ---
     Solid {
      translation -0.055 0 0.01  # Вынесен на самую корму
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.9 0.9 0.9
            roughness 0.3
            metalness 0.8
          }
          geometry Sphere {
            radius 0.01
          }
        }
        Pose {
          translation 0 0 0.005
          children [
            Shape {
              appearance PBRAppearance { baseColor 0.1 0.1 0.1 roughness 1 }
              geometry Cylinder {
                height 0.01
                radius 0.008
              }
            }
          ]
        }
      ]
      name "back_caster"
      boundingObject Sphere {
        radius 0.01
      }
      physics Physics {
        density -1
        mass 0.02
      }
    }    # --- 7. ДАТЧИКИ И СЕНСОРЫ ---
    InertialUnit {
      translation 0 0 0.05
      name "imu"
    }
    Accelerometer {
      translation 0 0 0.05
      name "accelerometer"
      xAxis TRUE
      yAxis TRUE
      zAxis TRUE
    }
    GPS {
      translation 0 0 0.08
      name "gps_ground_truth"
    }
  ]
  
  # --- 8. ОБЩИЕ ПАРАМЕТРЫ РОБОТА ---
  name "MyBot"
  boundingObject Pose {
    translation 0 0 0.035
    children [
      USE BODY
    ]
  }
  physics Physics {
    density -1
    mass 0.5
  }
  controller "webots_sil"
}


