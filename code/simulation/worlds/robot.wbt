#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  info [
    "SIL model of a differential-drive mobile robot."
  ]
  title "Differential Drive Robot"
  basicTimeStep 16
}

Viewpoint {
  orientation 0.10441349581936693 -0.969606685129755 -0.2212706443305736 5.382793309990334
  position -1.0665288896708753 -0.30238952230022664 1.3427364367002363
}

TexturedBackground {
}

TexturedBackgroundLight {
}

RectangleArena {
  floorSize 20 20
  floorTileSize 20 20
  wallHeight 0.1

  floorAppearance PBRAppearance {
    baseColor 0.8 0.8 0.8
    roughness 1
    metalness 0
  }
}

Robot {
  translation 0 0 0
  name "MyBot"
  controller "webots_sil"

  children [
    # Корпус.
    Pose {
      translation 0 0 0.035

      children [
        Shape {
          appearance DEF BODY_APPEARANCE PBRAppearance {
            baseColor 0.2 0.2 0.2
            roughness 0.8
            metalness 0.2
          }

          geometry DEF BODY_GEOMETRY Box {
            size 0.12 0.08 0.05
          }
        }
      ]
    }

    # Отрисовка траектории.
    Pen {
      translation 0 0 0.05
      name "pen"
      inkColor 1 0 0
      inkDensity 1
      leadSize 0.02
      maxDistance 0.5
      write TRUE
    }

    # Левое ведущее колесо.
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0

        # Центр левого колеса.
        anchor 0 0.05 0.025
      }

      device [
        RotationalMotor {
          name "left_wheel_motor"
          maxVelocity 100
          maxTorque 100
        }

        PositionSensor {
          name "left_wheel_encoder"
          resolution -1
        }
      ]

      endPoint Solid {
        translation 0 0.05 0.025
        name "left wheel"

        children [
          Pose {
            rotation 1 0 0 -1.57079632679

            children [
              Shape {
                appearance DEF WHEEL_APPEARANCE PBRAppearance {
                  baseColor 1 0 0
                  roughness 1
                  metalness 0
                }

                geometry DEF WHEEL_GEOMETRY Cylinder {
                  radius 0.025
                  height 0.01
                }
              }
            ]
          }
        ]

        boundingObject Pose {
          rotation 1 0 0 -1.57079632679

          children [
            USE WHEEL_GEOMETRY
          ]
        }

        physics Physics {
          density -1
          mass 0.05
        }
      }
    }

    # Правое ведущее колесо.
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 1 0

        # Центр правого колеса.
        anchor 0 -0.05 0.025
      }

      device [
        RotationalMotor {
          name "right_wheel_motor"
          maxVelocity 100
          maxTorque 100
        }

        PositionSensor {
          name "right_wheel_encoder"
          resolution -1
        }
      ]

      endPoint Solid {
        translation 0 -0.05 0.025
        name "right wheel"

        children [
          Pose {
            rotation 1 0 0 -1.57079632679

            children [
              Shape {
                appearance USE WHEEL_APPEARANCE
                geometry USE WHEEL_GEOMETRY
              }
            ]
          }
        ]

        boundingObject Pose {
          rotation 1 0 0 -1.57079632679

          children [
            USE WHEEL_GEOMETRY
          ]
        }

        physics Physics {
          density -1
          mass 0.05
        }
      }
    }

    # Передняя пассивная опора.
    Solid {
      translation 0.055 0 0.01
      name "front_caster"

      children [
        Shape {
          appearance DEF CASTER_APPEARANCE PBRAppearance {
            baseColor 0.9 0.9 0.9
            roughness 0.3
            metalness 0.8
          }

          geometry DEF CASTER_GEOMETRY Sphere {
            radius 0.01
          }
        }

        Pose {
          translation 0 0 0.005

          children [
            Shape {
              appearance DEF CASTER_SUPPORT_APPEARANCE PBRAppearance {
                baseColor 0.1 0.1 0.1
                roughness 1
                metalness 0
              }

              geometry DEF CASTER_SUPPORT_GEOMETRY Cylinder {
                height 0.01
                radius 0.008
              }
            }
          ]
        }
      ]

      boundingObject USE CASTER_GEOMETRY

      physics Physics {
        density -1
        mass 0.02
      }
    }

    # Задняя пассивная опора.
    Solid {
      translation -0.055 0 0.01
      name "back_caster"

      children [
        Shape {
          appearance USE CASTER_APPEARANCE
          geometry USE CASTER_GEOMETRY
        }

        Pose {
          translation 0 0 0.005

          children [
            Shape {
              appearance USE CASTER_SUPPORT_APPEARANCE
              geometry USE CASTER_SUPPORT_GEOMETRY
            }
          ]
        }
      ]

      boundingObject USE CASTER_GEOMETRY

      physics Physics {
        density -1
        mass 0.02
      }
    }

    # Датчики состояния.
    InertialUnit {
      translation 0 0 0.05
      name "imu"
    }

    Accelerometer {
      translation 0 0 0.05
      name "accelerometer"
      xAxis TRUE
      yAxis TRUE
      zAxis TRUE
    }

    GPS {
      translation 0 0 0.08
      name "gps_ground_truth"
    }
  ]

  boundingObject Pose {
    translation 0 0 0.035

    children [
      USE BODY_GEOMETRY
    ]
  }

  physics Physics {
    density -1
    mass 0.5
  }
}
