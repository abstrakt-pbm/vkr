{
  "version": 3,
  "configurePresets": [
    {
      "name": "host",
      "displayName": "Host Tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {"BUILD_TESTS": "ON"}
    },
    {
      "name": "arm",
      "displayName": "ARM Firmware",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm",
      "cacheVariables": {"CMAKE_TOOLCHAIN_FILE": "${sourceDir}/toolchain-arm.cmake"}
    }
  ],
  "buildPresets": [
    {
      "name": "tests",
      "configurePreset": "host",
      "targets": ["test_robot", "webots_sil", "webots_hil"]
    },
    {
      "name": "armware", 
      "configurePreset": "arm",
      "targets": ["firmware.elf"]
    }
  ]
}


